#!/bin/sh
# Правила проекта, которые легко забыть и невозможно заметить глазами.
# Держит их машина, а не память — см. tools/.
#
# Крючок включается один раз на копию репозитория:
#     git config core.hooksPath .githooks
# Обойти на один коммит, если очень надо: git commit --no-verify

if ! command -v node >/dev/null 2>&1; then
  echo "  ⚠ node не найден — правила не проверены. Проверь руками:"
  echo "      node tools/version.js check"
  echo "      node tools/palette.js check"
  echo "      node tools/type.js check"
  echo "      node tools/keys.js check"
  exit 0
fi

# Штамп версии в ссылках: без него правка не доедет до игрока из кеша.
node tools/version.js check || exit 1

# Палитра: новых кричащих цветов вне общей семьи не заводим.
node tools/palette.js check >/dev/null || { node tools/palette.js check; exit 1; }

# Кегль: текста мельче девяти пикселей в HUD быть не должно.
node tools/type.js check >/dev/null || { node tools/type.js check; exit 1; }

# Клавиши: в подсказках «R — поворот», на кнопке «поворот (R)», впритык нельзя.
node tools/keys.js check >/dev/null || { node tools/keys.js check; exit 1; }

exit 0
